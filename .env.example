# Hugging Face read token (hf.co -> Settings -> Access Tokens)
HF_TOKEN=

# Kaggle API creds (only needed for Kaggle datasets; kaggle.com -> Account -> Create New API Token)
KAGGLE_USERNAME=
KAGGLE_KEY=

# LLM providers (chain order: openai -> openrouter -> gemini -> anthropic)
# Verify live before demos:  uv run python scripts/verify_providers.py
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.6-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
LLM_MAX_TOKENS=700
ASSIST_MODE=null
